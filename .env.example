# Public base URL used in addon responses. Use an HTTPS URL when accessed remotely.
BASE_URL=http://localhost:7337
PORT=7337
DATA_DIR=/app/data
PUID=1000
PGID=1000

# Generate with: openssl rand -base64 32
MASTER_KEY=

# Source protections. Enable only when the Mixer must reach a host on its LAN.
ALLOW_INSECURE_HTTP=true
ALLOW_PRIVATE_NETWORK=true

# Enable a validated external torrent gateway before selecting torrent streams.
# It must expose GET /resolve?infoHash=<hash>&fileIdx=<index> and return { "url": "...", "headers": {} }.
TORRENT_GATEWAY_URL=

# Opt in before sending eligible public direct URLs to Torbox WebDL. URLs requiring
# proxy headers, cookies or request state are never sent to Torbox.
TORBOX_RESOLVE_URLS=false

# Keep active and completed progressive playback sessions and their media for this long after their last access.
SESSION_IDLE_MS=1800000

# Maximum wait for FFmpeg to produce the first playable HLS or fMP4 media.
STREAM_START_TIMEOUT_MS=120000

# Segment duration and one-time source-keyframe index timeout for lossless seekable HLS VOD.
SEEK_SEGMENT_SECONDS=4
KEYFRAME_INDEX_TIMEOUT_MS=1200000

# Experimental Nuvio account connector. Do not set until its current endpoints are verified.
NUVIO_API_BASE=https://api.nuvio.tv
